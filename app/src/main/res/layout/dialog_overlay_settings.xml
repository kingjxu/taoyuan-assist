<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textColor="@color/gto_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_strategy_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="决策策略"
        android:textColor="@color/gto_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/layout_strategy_selector"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_settings_selector">

        <Spinner
            android:id="@+id/spinner_strategy_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:popupBackground="@drawable/bg_strategy_dropdown"
            android:spinnerMode="dropdown" />

        <ImageView
            android:id="@+id/iv_strategy_dropdown"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:contentDescription="展开决策策略选项"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_settings_dropdown" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_strategy_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/gto_settings_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_font_size_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/gto_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="拖动滑块，下面会按实际悬浮窗字号实时预览"
        android:textColor="@color/gto_settings_text_secondary"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/seek_font_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="22"
        android:progressTint="@color/gto_accent"
        android:thumbTint="@color/gto_accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="悬浮窗预览"
        android:textColor="@color/gto_settings_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_preview"
        android:gravity="center"
        android:minHeight="104dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_font_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250dp"
            android:text="跟注 90"
            android:textColor="#FF0000"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
