<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gto_dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="桃园助手"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/gto_text_primary"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textSize="13sp"
                android:textColor="@color/gto_text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 注册表单卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/gto_text_primary"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_subtitle"
                android:textSize="13sp"
                android:textColor="@color/gto_text_secondary"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <!-- 邮箱 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="✉"
                    android:textSize="16sp"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/email_hint"
                    android:textColor="@color/gto_text_primary"
                    android:textColorHint="@color/gto_text_secondary"
                    android:inputType="textEmailAddress"
                    android:background="@null"
                    android:textSize="15sp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- 发送验证码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="📧"
                        android:textSize="16sp"
                        android:layout_marginEnd="10dp" />

                    <EditText
                        android:id="@+id/et_code"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="@string/code_hint"
                        android:textColor="@color/gto_text_primary"
                        android:textColorHint="@color/gto_text_secondary"
                        android:inputType="number"
                        android:maxLength="6"
                        android:background="@null"
                        android:textSize="15sp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_send_code"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:text="@string/btn_send_code"
                    android:textColor="@color/gto_accent"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_outline"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- 验证码提示 -->
            <TextView
                android:id="@+id/tv_code_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/gto_text_secondary"
                android:layout_marginBottom="12dp" />

            <!-- 密码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="16sp"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/password_hint"
                    android:textColor="@color/gto_text_primary"
                    android:textColorHint="@color/gto_text_secondary"
                    android:inputType="textPassword"
                    android:background="@null"
                    android:textSize="15sp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- 确认密码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="16sp"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/confirm_password_hint"
                    android:textColor="@color/gto_text_primary"
                    android:textColorHint="@color/gto_text_secondary"
                    android:inputType="textPassword"
                    android:background="@null"
                    android:textSize="15sp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- 注册按钮 -->
            <Button
                android:id="@+id/btn_register_submit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_register_submit"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_accent"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

            <!-- 返回登录 -->
            <Button
                android:id="@+id/btn_back_login"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_back_to_login"
                android:textColor="@color/gto_accent"
                android:textSize="16sp"
                android:background="@drawable/bg_btn_outline"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- 版权 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/footer_copyright"
            android:textSize="11sp"
            android:textColor="@color/gto_text_secondary"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_version"
            android:textSize="11sp"
            android:textColor="@color/gto_text_secondary"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
